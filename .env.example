# Copy to .env (or set these as real environment variables / secrets in your
# deployment platform) and fill in real values. Never commit the filled-in file.

# Database
BOOKY_DB_URL=jdbc:mysql://localhost:3306/booky_db
BOOKY_DB_USERNAME=root
BOOKY_DB_PASSWORD=changeme

# JWT signing secret - must be base64 and decode to at least 32 bytes.
# Generate one with: openssl rand -base64 48
BOOKY_JWT_SECRET=changeme-generate-a-long-random-base64-secret

# Mail (optional - leave booky.email.enabled=false to disable notifications)
BOOKY_MAIL_USERNAME=disabled@booky.local
BOOKY_MAIL_PASSWORD=disabled
BOOKY_SHOW_SQL=false

# Comma-separated origins allowed to call the API from a browser
BOOKY_ALLOWED_ORIGINS=https://yourdomain.com

# Port Spring Boot listens on
PORT=8080

# Use the prod profile (ddl-auto=validate, SQL logging off) in production
SPRING_PROFILES_ACTIVE=prod
