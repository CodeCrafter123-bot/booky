# Copy to .env (or set these as real environment variables / secrets in your
# deployment platform) and fill in real values. Never commit the filled-in file.

# Database
DB_URL=jdbc:mysql://localhost:3306/booky_db
DB_USERNAME=root
DB_PASSWORD=changeme

# JWT signing secret - must be at least 32 bytes, random, and kept secret.
# Generate one with: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# Mail (optional, leave booky.email.enabled=false to disable)
BOOKY_MAIL_USERNAME=disabled@booky.local
BOOKY_MAIL_PASSWORD=disabled

# Set to "prod" in production
SPRING_PROFILES_ACTIVE=prod
